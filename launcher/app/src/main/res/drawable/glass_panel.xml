<?xml version="1.0" encoding="utf-8"?>
<!-- Clear glass: a light smoke so the text stays readable, a white sheen over it and a fine bright rim. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#59121216" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#38FFFFFF" android:endColor="#12FFFFFF" />
            <stroke android:width="1dp" android:color="#6BFFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
